@using System.Diagnostics
<div class="game">
<div class="game-topstatusbar">
	<p class="game-topstatusbar-title">Relics of Adofai</p>
	<p class="game-topstatusbar-playername">@this.Context.PlayerName</p>
	<div class="game-topstatusbar-stat">
		<span>技术</span>
		<span class="game-topstatusbar-stat-margin-small color-skill">@this.Context.Skill.ToString("0.00")</span>
		<span class="game-topstatusbar-stat-margin-large">名声</span>
		<span class="game-topstatusbar-stat-margin-small color-follower">@this.Context.FollowerCount</span>
        <span class="game-topstatusbar-stat-margin-large">资金</span>
        <span class="game-topstatusbar-stat-margin-small color-money">@this.Context.Money.ToString("0.00")</span>
	</div>
	<p class="game-topstatusbar-dayinfo">
		第@(this.Context.Day)天<span style="margin-left: 1ch;"></span>
		@(Math.Floor(this.Context.Hour).ToString("00")):@(Math.Floor((this.Context.Hour % 1.0) * 60).ToString("00"))
	</p>
	<button class="game-topstatusbar-finishday" type="button" @onclick="this.Context.FinishDay">收工睡觉</button>
</div>

<div style="display: flex; flex-direction: row; margin: 4ch;">
    <div class="game-charts">
	<select @bind="@this.SortStrategy" style="margin-left: 1ch; width: fit-content; padding-right: 4ch;">
        <option value="@ChartSortStrategy.Default">默认</option>
        <option value="@ChartSortStrategy.DifficultyAscending">技术难度 升序</option>
        <option value="@ChartSortStrategy.DifficultyDescending">技术难度 降序</option>
	</select>
    @foreach (var chart in this.GetSortedCharts())
    {
    <div class="game-charts-singlechartitem">
        <div style="display: flex; flex-direction: row; margin-bottom: 0px;">
            <span style="font-size: 10px;">@chart.Artist</span>
            <span style="font-size: 10px; margin-left: auto;">@chart.Creator</span>
        </div>
        <p style="font-weight: bold; font-size: 18px; margin-bottom: 1ch; margin-top: 0px;">@chart.Song</p>
        @*@todo: change this to rating, and hide the required skill, which both reflects the wackiness of ratings,
        but also the challenge to actually estimate the skill required to beat the level.*@	
		<div style="display: flex; flex-direction: row;">
			<img src="@("pgu/" + this.Context.TranslatePgu(chart) + ".png")"
				 alt="@this.Context.TranslatePgu(chart)"
				 style="height: 36px; margin: 0px;"/>
			<span class="color-skill" style="margin-left: auto; align-self: end;">@chart.RequiredSkill.ToString("0.00")</span>
		</div>
    </div>
    }
    </div>

	<div style="display: flex; flex-direction: column; width: 100%; margin-left: 3ch;">
	<div class="game-events">
    @foreach (var choiceEvent in this.Context.ChoiceEvents)
    {
    <div class="game-events-singleeventitem">
		<p style="font-weight: bold; font-size: 24px; margin-top: 0ch;">@choiceEvent.Title</p>
        <p>@(new MarkupString(choiceEvent.Description.Replace("\n", "<br>")))</p>
		<div style="margin-top: 0.5ch; display: flex; flex-direction: row;">
		@foreach (var choice in choiceEvent.Choices)
		{
			<button disabled="@(!choice.IsChoiceAvailable(this.Context))"
			        @onclick="_ => this.TakeChoice(choiceEvent, choice)"
				    style="padding: 0.5ch 1.5ch; margin-right: 0.5ch;" type="button">
				@choice.Text
			</button>
		}
		</div>
	</div>
    }
    </div>
	<div class="game-log">
		@(new MarkupString(this.Context.Log.ToString()))
	</div>
	</div>
</div>
</div>

@code {
	[Parameter]
	public required GameContext Context { get; set; }

	public enum ChartSortStrategy
	{
		Default,
		DifficultyAscending,
		DifficultyDescending,
	}
	public ChartSortStrategy SortStrategy = ChartSortStrategy.DifficultyAscending;
	public IEnumerable<Chart> GetSortedCharts()
	{
		return this.SortStrategy switch
		{
			ChartSortStrategy.Default => this.Context.Charts,
			ChartSortStrategy.DifficultyAscending => this.Context.Charts.OrderBy(c => c.RequiredSkill),
			ChartSortStrategy.DifficultyDescending => this.Context.Charts.OrderByDescending(c => c.RequiredSkill),
			_ => this.Context.Charts,
		};
	}

	protected override void OnInitialized()
	{
		// @hack: The constructor will run first before the fields are set.
		// So, to properly get the player name and other stuff, we put init here.
		// This should not be here, though ...
		this.Context.ImportStartupEvents();
		base.OnInitialized();
	}

	public void TakeChoice(ChoiceEvent choiceEvent, Choice choice)
	{
		choice.Consequence(this.Context);
		bool removeSuccess = this.Context.ChoiceEvents.Remove(choiceEvent);
		Debug.Assert(removeSuccess, "Cannot remove a choice event!");
	}
}
