<div class="game">
<div class="game-topstatusbar">
	<p class="game-topstatusbar-title">Relics of Adofai</p>
	<p class="game-topstatusbar-playername">@this.Context.PlayerName</p>
	<div class="game-topstatusbar-stat">
		<span>技能</span>
		<span class="game-topstatusbar-stat-margin-small color-skill">@this.Context.Skill</span>
		<span class="game-topstatusbar-stat-margin-large">名声</span>
		<span class="game-topstatusbar-stat-margin-small color-follower">@this.Context.FollowerCount</span>
        <span class="game-topstatusbar-stat-margin-large">资金</span>
        <span class="game-topstatusbar-stat-margin-small color-money">@this.Context.Money</span>
	</div>
	<p class="game-topstatusbar-dayinfo">
		第@(this.Context.Day)天<span style="margin-left: 1ch;"></span>
		@(Math.Floor(this.Context.Hour).ToString("00")):@(Math.Floor((this.Context.Hour % 1.0) * 60).ToString("00"))
	</p>
	<button class="game-topstatusbar-finishday" type="button" @onclick="this.FinishDay">结束今天</button>
</div>

<div style="margin: 4ch;">
<div class="game-content">
    @*@todo: Filters on the chart because things will get out of hand very, very quickly (within tens of in-game days)*@
    <div class="game-charts">
    @foreach (var chart in this.Context.Charts)
    {
    <div class="game-charts-singlechartitem">
        <p style="font-weight: bold; font-size: 18px; margin: 0px;">@chart.Song</p>
        <p style="font-size: 10px; margin-top: 0ch; margin-bottom: 1.5ch;">@chart.Artist</p>
        @*@todo: change this to rating, and hide the required skill, which both reflects the wackiness of ratings,
        but also the challenge to actually estimate the skill required to beat the level.*@	
        <span>谱面难度: </span>
        <span class="color-skill">@chart.RequiredSkill</span>
    </div>
    }
    </div>

	<div class="game-events">
    @foreach (var choiceEvent in this.Context.ChoiceEvents)
    {
    <div class="game-events-singleeventitem">
        <p>@choiceEvent.Description</p>
    </div>
    }
    </div>
</div>
</div>
</div>

@code {
	[Parameter]
	public required GameContext Context { get; set; }

	public void FinishDay()
	{
		this.Context.FinishDay();
	}
}
