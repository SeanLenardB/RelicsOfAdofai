@page "/"
@using System.Text
@using System.Diagnostics
@rendermode InteractiveServer

<PageTitle>Relics of Adofai</PageTitle>

@if (this.Context is null)
{
<h1 class="title">Relics of Adofai</h1>
<div class="settingbox">
	<div class="settingrow">
		<p>随机数种子</p>
		<input @bind-value="this.Seed" type="number" />
	</div>
	<div class="settingrow">
		<p>玩家名</p>
		<input @bind-value="this.PlayerName"/>
	</div>

	<p style="margin-top: 4ch; margin-bottom: 1ch; text-align: center;">或者载入存档</p>
	<InputFile style="align-self: center;" OnChange="this.LoadSave"/>
	@if (this.SaveFileLines is null)
	{
		<button type="button" @onclick="this.StartGame">开始新游戏</button>
	}
	else
	{
		<button type="button" @onclick="this.StartGame">加载存档</button>
	}
	@if (!string.IsNullOrWhiteSpace(this.LoadSaveError))
	{
		<p style="color: red; text-align: center;">@this.LoadSaveError</p>
	}
	</div>
}
else
{
	<Game Context="this.Context"></Game>
}

@*@cleanup: put this into a constant variable place*@
<div class="credit">
	<p>Created by SeanLB & quartrond. Relics Version @(GameContext.Version). <a style="color: lightblue" href="https://github.com/SeanLenardB/RelicsOfAdofai">View on GitHub</a></p>
	<p>Data are fake. Please don't take this seriously.</p>
</div>

@code {
	public int Seed { get; set; } = 114514;
	public string PlayerName { get; set; } = "Quartrond";

	public GameContext? Context;
	public void StartGame()
	{
		GameContext context = new(this.Seed);
		context.PlayerName = this.PlayerName;
		context.ImportStartupEvents();
		if (this.SaveFileLines is not null) context.LoadPersistency(this.SaveFileLines);

		this.Context = context;
	}

	public string? LoadSaveError;
	public List<string>? SaveFileLines;
	public async void LoadSave(InputFileChangeEventArgs e)
	{
		if (e.FileCount != 1) return;

		using var saveStream = e.File.OpenReadStream();
		byte[] buffer = new byte[512000];
		await saveStream.ReadAsync(buffer);

		this.SaveFileLines = [.. Encoding.Default.GetString(buffer).Split('\n')];
		if (this.SaveFileLines.Count < 3)
		{
			this.LoadSaveError = "存档格式有误";
			this.SaveFileLines = null;
			return;
		}

		if (!int.TryParse(this.SaveFileLines[0], out var version)) version = 1;
		if (GameContext.Version != version)
		{
			this.LoadSaveError = $"存档版本为{version}，但当前游戏版本为{GameContext.Version}";
			return;
		}

		this.PlayerName = this.SaveFileLines[1];
		this.Seed = int.Parse(this.SaveFileLines[2]);
		this.StateHasChanged();  // For unknown reasons the button won't update.
	}
}
